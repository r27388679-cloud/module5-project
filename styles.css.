/* Reset e configuração inicial */
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: Arial, sans-serif;
  padding: 20px;
}

h1 {
  text-align: center;
  margin-bottom: 30px;
}

/* Estilo geral das seções */
.row {
  width: 100%;
}

.col {
  border: 1px solid black;
  background-color: #f0f0f0;
  margin: 10px;
  padding: 40px 15px 15px 15px;
  position: relative;
}

.section-title {
  position: absolute;
  top: 0;
  right: 0;
  background-color: #ffcc00;
  border: 1px solid black;
  padding: 5px 10px;
  font-weight: bold;
}

/* === Layout para Desktop (>= 992px) === */
@media (min-width: 992px) {
  .col {
    float: left;
    width: 30%;
  }
}

/* === Layout para Tablet (768px - 991px) === */
@media (min-width: 768px) and (max-width: 991px) {
  .col-1, .col-2 {
    float: left;
    width: 47%;
  }
  .col-3 {
    width: 96%;
    clear: both;
  }
}

/* === Layout para Mobile (<= 767px) === */
@media (max-width: 767px) {
  .col {
    width: 100%;
  }
}
